---
// "One database for every agent": agents and code connect through relate to your data. Pixel-art
// sprites are drawn at build time (src/lib/home/sprites.ts); the hub's dither bar is a canvas.
import { sprite } from '../lib/home/sprites.ts';
---
<section class="dgw">
<div class="dgt"><div class="mb-t"><h2 id="h-dgs">One database for every agent.</h2><p class="lede">Every agent, script and app reads and writes the same graph, kept in memory, a directory or one file. No server to run.</p></div></div>
<div class="dgs" role="region" aria-labelledby="h-dgs">
    <div class="dstage" role="img" aria-label="Agents and code connect through Relate to your data">
      <div class="ddg">
        <div class="dapp"><span class="dal">Your application</span>
        <div class="dcol dl">
          <div class="dgrp"><p class="dlbl">Agent skill &middot; MCP</p>
            <div class="dnd"><span class="dstk"><svg viewBox="-1 -1 26 26" fill="#D97757" fill-rule="evenodd" shape-rendering="crispEdges" aria-hidden="true"><path d="M20.998 10.949H24v3.102h-3v3.028h-1.487V20H18v-2.921h-1.487V20H15v-2.921H9V20H7.488v-2.921H6V20H4.487v-2.921H3V14.05H0V10.95h3V5h17.998v5.949zM6 10.949h1.488V8.102H6v2.847zm10.51 0H18V8.102h-1.49v2.847z"/></svg></span>Claude Code</div>
            <div class="dnd"><span class="dstk"><svg viewBox="0 0 20 20" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M7 1h4v1H7z M5 2h10v1H5z M5 3h11v1H5z M4 4h13v1H4z M2 5h16v1H2z M2 6h16v1H2z M1 7h4v1H1z M7 7h11v1H7z M1 8h5v1H1z M7 8h11v1H7z M1 9h5v1H1z M8 9h11v1H8z M1 10h5v1H1z M8 10h11v1H8z M2 11h4v1H2z M7 11h12v1H7z M2 12h3v1H2z M7 12h3v1H7z M15 12h4v1H15z M2 13h16v1H2z M2 14h16v1H2z M3 15h13v1H3z M4 16h11v1H4z M5 17h10v1H5z M9 18h4v1H9z"/></svg></span>Codex</div>
            <div class="dnd"><span class="dstk"><svg viewBox="0 0 20 20" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M9 1h2v1H9z M7 2h6v1H7z M5 3h10v1H5z M4 4h12v1H4z M2 5h16v1H2z M2 6h2v1H2z M17 6h1v1H17z M2 7h4v1H2z M16 7h2v1H16z M2 8h6v1H2z M16 8h2v1H16z M2 9h7v1H2z M15 9h3v1H15z M2 10h8v1H2z M15 10h3v1H15z M2 11h8v1H2z M14 11h4v1H14z M2 12h8v1H2z M13 12h5v1H13z M2 13h8v1H2z M13 13h5v1H13z M2 14h8v1H2z M12 14h6v1H12z M4 15h6v1H4z M12 15h4v1H12z M5 16h5v1H5z M11 16h4v1H11z M7 17h3v1H7z M11 17h2v1H11z M9 18h2v1H9z"/></svg></span>Cursor</div>
            <div class="dnd"><span class="dstk" set:html={sprite('plug')} />Any MCP client</div>
          </div>
          <div class="dgrp"><p class="dlbl">CLI &middot; Libraries</p>
            <div class="dnd"><span class="dstk" set:html={sprite('terminal')} />Shell</div>
            <div class="dnd"><span class="dstk" set:html={sprite('py')} />Python</div>
            <div class="dnd"><span class="dstk" set:html={sprite('js')} />JavaScript</div>
            <div class="dnd"><span class="dstk" set:html={sprite('rs')} />Rust</div>
          </div>
        </div>
        <div class="dlk dl"><span>Cypher</span></div>
        <div class="dhub">
          <span class="hk">Embedded library</span>
          <div class="mid"><span class="hs">Stores data</span>
          <div class="dchips"><span>in memory</span><span>a directory</span><span>one file</span></div></div>
          <div class="hbot"><span class="htag"><svg viewBox="15.2 0 34.3 10" aria-hidden="true"><use href="/lockup.svg#lockup" width="49.5" height="10" /></svg></span>
          <canvas id="dither" aria-hidden="true"></canvas></div>
        </div>
        </div>
        <div class="dlk dr"><span>Reads and writes</span></div>
        <div class="dcol dr">
          <div class="dgrp"><p class="dlbl">Your data</p>
            <div class="dnd"><span class="dstk" set:html={sprite('memory')} />Agent memory</div>
            <div class="dnd"><span class="dstk" set:html={sprite('code')} />Codebase</div>
            <div class="dnd"><span class="dstk" set:html={sprite('star')} />Recommendations</div>
            <div class="dnd more"><span class="dstk" set:html={sprite('plus')} />Your own data</div>
          </div>
        </div>
      </div>
    </div>
    <div class="dfc">
      <div><h3>Open source</h3><p>Read the code, run it locally, and add your own recipes.</p></div>
      <div><h3>Part of your application</h3><p>Relate runs inside your application. Keep your data in memory, in a directory, or in one file.</p></div>
      <div><h3>Cypher, for connected data</h3><p>Your agent asks in Cypher and gets back how the facts connect. Skill and MCP endpoint included.</p></div>
      <div><h3>Start in minutes</h3><p>No signup. No server to deploy.</p></div>
    </div>
</div>
</section>

<style>
  .dgw { padding: 0 24px 120px; background: var(--surface-0); }
  .dgt { max-width: var(--page-w); margin: 0 auto; padding: 0 0 56px; }
  .mb-t { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 64px; align-items: end; }
  .mb-t h2 { margin: 0; max-width: 16ch; font: 500 clamp(30px, 3.2vw, 48px) / 1.04 var(--font); letter-spacing: -.04em; }
  .mb-t .lede { margin: 0; max-width: 52ch; color: var(--ink-muted); font-size: 17px; line-height: 28px; }

  .dgs { --lc: var(--line); max-width: var(--page-w); margin: 0 auto; border: 1px solid var(--line); background: var(--surface-0); }
  .dgs, .dgs :global(*) { box-sizing: border-box; }
  .dstage { display: flex; justify-content: center; padding: 96px 32px; background-color: var(--surface-2); border-bottom: 1px solid var(--line); }
  .ddg { display: grid; grid-template-columns: auto auto auto; align-items: start; justify-content: center; }
  .dcol { position: relative; display: flex; flex-direction: column; gap: 32px; padding: 0; }
  .dlbl { margin: 0 0 10px; font: 500 12px/1 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); white-space: nowrap; }
  .dgrp { display: flex; flex-direction: column; gap: 10px; }
  .dnd {
    display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 16px; white-space: nowrap;
    background: var(--win); border: 1px solid var(--line); color: var(--ink); font: 500 15px/1 var(--font); box-shadow: var(--ui-shadow);
  }
  .dstk { display: flex; flex: none; width: 20px; height: 20px; }
  .dstk :global(svg) { width: 20px; height: 20px; image-rendering: pixelated; }
  .dnd.more { border: 2px solid var(--ink-muted); }
  .dnd.more .dstk { filter: grayscale(1); }
  .dstk :global([fill='#181414']) { fill: var(--ink); }
  .dcol.dl .dgrp { align-items: stretch; }
  .dcol.dl { min-width: 230px; }
  .dapp { position: relative; display: flex; align-items: flex-start; padding: 72px 24px 24px; border: 1px solid var(--line); background: var(--surface-0); }
  .dal { position: absolute; left: 24px; top: 22px; font: 500 12px/1 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); }
  .dcol::after { content: ''; position: absolute; top: 56px; bottom: 24px; width: 14px; border: 1px solid var(--lc); }
  .dcol.dl::after { right: -14px; border-left: 0; }
  .dcol.dr::after { left: -14px; border-right: 0; }
  .dcol.dr { margin-top: 216px; }
  .dlk { position: relative; height: 1px; margin-top: 286px; background: var(--lc); }
  .dlk span {
    position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%); padding: 5px 8px;
    background: var(--surface-0); border: 1px solid var(--line-strong); text-align: center; white-space: nowrap;
    font: 500 11px/1 var(--mono); letter-spacing: .04em; color: var(--ink);
  }
  .dlk::after { content: ''; position: absolute; right: -1px; top: -5px; border-left: 7px solid var(--lc); border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .dlk.dl { width: 96px; margin-left: 13px; }
  .dlk.dr { width: 170px; margin-right: 13px; margin-top: 359px; }
  .dhub {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    width: 320px; height: 222px; margin-top: 175px; padding: 20px;
    background: var(--win); border: 1px solid var(--line); box-shadow: var(--ui-shadow);
  }
  .dhub::after { content: ''; position: absolute; left: 100%; top: 110px; width: 25px; height: 1px; background: var(--lc); }
  .dhub .hk, .dhub .hs { font: 500 11px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); }
  .dhub .hs { display: block; margin-bottom: 10px; }
  .dchips { display: flex; flex-wrap: wrap; gap: 6px; }
  .dchips span { padding: 5px 8px; border: 1px solid var(--line); font: 500 11px/1 var(--mono); color: var(--ink); }
  .hbot { display: flex; flex-direction: column; gap: 12px; }
  .htag { display: block; height: 16px; }
  .htag svg { height: 16px; width: auto; color: var(--ink); }
  .dhub canvas { display: block; width: 100%; height: 28px; }

  .dfc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .dfc > div { padding: 32px; border-left: 1px solid var(--line); }
  .dfc > div:first-child { border-left: 0; }
  .dfc h3 { margin: 0 0 16px; max-width: 14ch; font: 600 22px/1.2 var(--font); letter-spacing: -.025em; }
  .dfc p { margin: 0; color: var(--ink-muted); font: 400 15px/1.55 var(--font); }

  @media (max-width: 1120px) {
    .dstage { padding: 64px 16px; }
    .dcol.dl { min-width: 200px; }
    .dlk.dl { width: 64px; }
    .dhub { width: 240px; }
    .dlk.dr { width: 120px; }
  }
  @media (max-width: 1000px) {
    .dgw { padding: 0 16px 120px; }
    .mb-t { display: block; }
    .mb-t .lede { margin-top: 20px; }
    .dfc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dfc > div:nth-child(3) { border-left: 0; }
    .dfc > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .dstage { padding: 48px 16px; }
    .ddg { grid-template-columns: 1fr; justify-items: center; gap: 0; }
    .dapp { flex-direction: column; align-items: center; justify-self: stretch; width: 100%; padding: 56px 16px 24px; margin-right: 8px; margin-bottom: 8px; }
    .dlk, .dlk.dl, .dlk.dr { width: 1px; height: 48px; margin: 0 !important; justify-self: center; }
    .dlk span { left: 12px; bottom: 16px; top: auto; transform: none; text-align: left; }
    .dlk::after, .dcol::after, .dhub::after { display: none; }
    .dhub, .dcol.dr { margin-top: 0; }
    .dcol.dr { justify-self: center; }
    .dhub { width: 100%; max-width: none; height: auto; gap: 16px; align-self: stretch; }
    .dcol.dl { align-self: stretch; max-width: none; }
    .dcol.dl .dnd { width: 100%; }
    .dcol, .dcol.dl { min-width: 0; width: 100%; max-width: 320px; }
  }
  @media (max-width: 560px) {
    .dfc { grid-template-columns: 1fr; }
    .dfc > div { padding-left: 20px; padding-right: 20px; border-left: 0; border-top: 1px solid var(--line); }
    .dfc > div:first-child { border-top: 0; }
    .dhub { max-width: 320px; }
  }
</style>

<script>
  // The hub's dither bar: brand-colour pixels in a Bayer pattern, with a soft front sweeping along it.
  const cv = document.getElementById('dither') as HTMLCanvasElement | null;
  const ctx = cv?.getContext('2d');
  if (cv && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const C = 4;
    const bayer = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 5, 13, 7]].map((r) => r.map((v) => v / 16));
    let W = 0, H = 0, cols = 0, rows = 0;
    let visible = true;
    let running = false;
    const size = () => {
      const dpr = Math.min(2, devicePixelRatio || 1);
      W = cv.clientWidth;
      H = cv.clientHeight;
      cv.width = W * dpr;
      cv.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.floor(W / C);
      rows = Math.floor(H / C);
    };
    const draw = (t: number) => {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = getComputedStyle(cv).getPropertyValue('--brand').trim() || '#0A6190';
      const head = ((t / 1000) * 0.35) % 1.35;
      for (let x = 0; x < cols; x++) {
        const d = head - x / cols;
        let lvl = d < 0 ? 0 : Math.max(0.12, 1 - d * 1.6);
        if (d > 1) lvl = 0.12;
        for (let y = 0; y < rows; y++) if (lvl > bayer[y % 4][x % 4] + 0.02) ctx.fillRect(x * C, y * C, C, C);
      }
    };
    const frame = (now: number) => {
      if (!running) return;
      draw(now);
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (reduce || running || !visible || document.hidden) return;
      running = true;
      requestAnimationFrame(frame);
    };
    new ResizeObserver(() => { size(); if (reduce) draw(2400); }).observe(cv);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) start(); else running = false;
    }).observe(cv);
    document.addEventListener('visibilitychange', () => { if (document.hidden) running = false; else start(); });
    size();
    if (reduce) draw(2400); else start();
  }
</script>
