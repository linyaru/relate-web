---
// Shared page shell for section pages (/docs, /blog, ...): head, global styles, top bar, footer.
// The home page still renders the legacy markup (src/pages/index.astro) but uses the same
// Header and Footer components and base.css.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';
interface Props { title: string; description?: string; playgroundHref?: string }
const { title, description = '', playgroundHref } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — relate</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="preload" href="/fonts/relate-sans.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <slot name="head" />
  </head>
  <body>
    <Header playgroundHref={playgroundHref} />
    <main class="page container" id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
