---
// <Errors />: the errors tables, generated from _data/errors.json. The table
// model and the twin live in errors.ts; this renders the same rows as HTML
// (src/lib/docs/generated/table.ts), each <tr> at its entry's stable id, with
// the id cell linking to itself.
import { publishedIds } from '../../lib/docs/content.ts';
import { tableHtml } from '../../lib/docs/generated/table.ts';
import { table } from './errors.ts';

interface Props {
  surface?: string;
}
const html = tableHtml(table(Astro.props as Record<string, string>), publishedIds(), { table: 'errors-table', anchor: 'errors-anchor' });
---
<div class="docs-errors" set:html={html} />
