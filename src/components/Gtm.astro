---
// Google Tag Manager behind consent (ADR-0063). Goes last in <head>. It defaults every consent
// signal to denied, loads the container only once the visitor has accepted (now, from a stored
// choice, or after the banner), and exposes `window.relateConsent` to the banner and the
// footer's "Cookie settings" button. Renders nothing on a non-indexable build (a preview).
import { indexable } from '../lib/seo.ts';
const id = 'GTM-WJZF33JM';
const code = `(function(w,d){var k='relate-consent',loaded=false;w.dataLayer=w.dataLayer||[];function g(){w.dataLayer.push(arguments)}
var all=['ad_storage','ad_user_data','ad_personalization','analytics_storage'];
function state(v){var o={};all.forEach(function(n){o[n]=v});return o}
g('consent','default',state('denied'));
function get(){try{return localStorage.getItem(k)}catch(e){return null}}
function load(){if(loaded)return;loaded=true;g('consent','update',state('granted'));w.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});var s=d.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtm.js?id=${id}';d.head.appendChild(s)}
function set(v){try{localStorage.setItem(k,v)}catch(e){}if(v==='granted')load();else if(loaded)location.reload()}
w.relateConsent={get:get,set:set};
if(get()==='granted')load()})(window,document);`;
---
{indexable() && <script is:inline set:html={code} />}
