---
// Placeholder section page (/docs, /blog) on the shared shell.
import Base from './Base.astro';
interface Props { title: string; description?: string }
---
<Base {...Astro.props}>
  <div class="placeholder"><slot /></div>
</Base>

<style is:global>
  .page { padding-top: 48px; padding-bottom: 96px; }
  .placeholder { max-width: 760px; }
  .placeholder h1 { font-size: 2rem; line-height: 1.2; margin: 0 0 12px; }
  .placeholder p.lead { color: var(--fg-muted); font-size: 1.1rem; margin: 0 0 24px; }
  .placeholder a { color: var(--accent); }
  .placeholder .soon { display: inline-block; padding: 2px 10px; border: 1px solid var(--border); border-radius: 999px; font: 400 0.8rem var(--font-mono); color: var(--fg-muted); margin-bottom: 12px; }
</style>
