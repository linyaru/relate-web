---
// <Install />: the install block (DOCS-PLAN.md §3.4). The content and the twin
// live in install.ts; this renders the same pieces as the page shows them:
// tab sets in the `.tabs` / `.tab-panel` structure the ::::tabs directive
// renders (so the layout script enhances them, and every panel shows without
// JavaScript), and code blocks with the docs' Copy button.
import MarkdownIt from 'markdown-it';

import { esc } from '../../lib/cookbook/result-view.ts';
import { publishedIds } from '../../lib/docs/content.ts';
import { highlighter } from '../../lib/docs/highlight.ts';
import { resolveHref } from '../../lib/docs/links.ts';
import { nextId, pieces, type Block, type Tab } from './install.ts';

interface Props {
  part?: string;
}
const highlight = await highlighter();
const pages = publishedIds();
// Inline markdown with raw HTML off (a `<placeholder>` in prose stays text);
// links resolve first, so one that is not built or not public keeps its text.
const markdown = new MarkdownIt({ html: false, linkify: false });
const md = {
  renderInline: (s: string) =>
    markdown.renderInline(
      s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, label: string, href: string) => {
        const resolved = resolveHref(href, { pages });
        return resolved === null ? label : `[${label}](${resolved})`;
      }),
    ),
};

const block = (b: Block) => {
  if ('p' in b) return `<p>${md.renderInline(b.p)}</p>`;
  const id = nextId();
  return (
    `<div class="code-block">${highlight(b.code, b.lang)}<textarea id="${id}" hidden>${esc(b.code)}</textarea>` +
    `<button class="copy-btn" type="button" data-copy-target="${id}" hidden>Copy</button></div>`
  );
};
const tabSet = (list: Tab[], detect?: string): string =>
  `<div class="tabs docs-install-tabs" data-tabs${detect ? ` data-tabs-detect="${detect}"` : ''}>` +
  list
    .map(
      (t) =>
        `<div class="tab-panel" data-tab-key="${esc(t.key)}" data-tab-label="${esc(t.label)}"><p class="tab-label">${esc(t.label)}</p>` +
        t.blocks.map(block).join('') +
        (t.tabs ? tabSet(t.tabs, t.key === 'cli' ? 'os' : undefined) : '') +
        '</div>',
    )
    .join('') +
  '</div>';

const html = pieces(Astro.props as Record<string, string>)
  .map((piece) => {
    if ('tabs' in piece) return tabSet(piece.tabs);
    const body = piece.blocks.map(block).join('');
    return 'label' in piece ? `<div class="docs-install-agents-md"><p><strong>${esc(piece.label)}</strong></p>${body}</div>` : body;
  })
  .join('');
---
<div class="docs-install" set:html={html} />
