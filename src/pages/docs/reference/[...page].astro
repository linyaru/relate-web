---
// A generated docs page (src/lib/docs/generated/: the glossary and the
// changelog) at /docs/reference/<page>/, where <page> may have more than one
// segment, in the same chrome as an authored page (../[...slug].astro). Its body is rendered from
// data at build time; its twin is /docs/reference/<page>.md ([...page].md.ts).
import PageActions from '../../../components/docs/PageActions.astro';
import Docs from '../../../layouts/Docs.astro';
import { GENERATED_PAGES, pageUrl } from '../../../lib/docs/model.ts';
import { breadcrumb, prevNext } from '../../../lib/docs/nav.ts';
import { docsSite } from '../../../lib/docs/site.ts';
import { articleGraph } from '../../../lib/seo.ts';

export async function getStaticPaths() {
  const outside = GENERATED_PAGES.filter((p) => !p.id.startsWith('reference/'));
  if (outside.length) throw new Error(`generated pages outside reference/ need a route: ${outside.map((p) => p.id).join(', ')}`);
  return GENERATED_PAGES.map((p) => ({ params: { page: p.id.slice('reference/'.length) }, props: { id: p.id } }));
}

interface Props { id: string }
const site = await docsSite();
const page = site.generated.find((g) => g.id === Astro.props.id)!;
const { html, headings, head } = page.rendered();
const crumbs = breadcrumb(site.nav, page.id);
const { prev, next } = prevNext(site.nav, page.id);
const jsonld = [articleGraph({ title: page.meta.title, description: page.meta.description, path: page.url, modified: page.lastUpdated, crumbs })];
---
<Docs title={page.meta.title} description={page.meta.description} nav={site.nav} current={page.id} headings={headings} twinHref={page.twinUrl} modified={page.lastUpdated} jsonld={jsonld}>
  {head && <Fragment slot="head" set:html={head} />}
  <div class="doc-top">
  <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
    <ol>
      {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>)}
    </ol>
  </nav>
  <PageActions twinHref={page.twinUrl} verified={site.engine.verified} />
  </div>
  <header class="doc-head">
    <h1>{page.meta.title}</h1>
    <p class="lede">{page.meta.description}</p>
  </header>
  <div class="docs-body generated" set:html={html} />
  {(prev || next) && (
    <nav class="prev-next" aria-label="Previous and next" data-pagefind-ignore>
      {prev ? <a class="prev" href={pageUrl(prev.id)}><span>Previous</span>{prev.label}</a> : <span></span>}
      {next && <a class="next" href={pageUrl(next.id)}><span>Next</span>{next.label}</a>}
    </nav>
  )}
  <footer class="doc-foot" data-pagefind-ignore>
    <span>Verified against relate {site.engine.verified} · Updated {page.lastUpdated}</span>
    <span class="links">
      <a href={page.twinUrl}>Markdown</a>
      <a href="/docs/llms.txt" target="_blank" rel="noopener">llms.txt</a>
    </span>
  </footer>
</Docs>

<style>
  /* The glossary: one entry per term, its anchor the term's id. */
  .generated :global(dl.glossary) { margin: 8px 0 24px; }
  .generated :global(.glossary-entry) { padding: 10px 0; border-bottom: 1px solid var(--border); scroll-margin-top: 96px; }
  .generated :global(.glossary-entry:target) { background: var(--bg-alt); }
  .generated :global(.glossary-entry dt) { font-weight: 600; }
  .generated :global(.glossary-entry dt a) { color: inherit; text-decoration: none; }
  .generated :global(.glossary-entry dd) { margin: 4px 0 0; }
  .generated :global(.glossary-entry dd p) { margin: 4px 0; }
  .generated :global(.glossary-meta) { color: var(--fg-muted); font-size: 14px; }
  /* The changelog: a deep link to a release (#<version>, #since-<version>) marks it. */
  .generated :global(.changelog-release:target), .generated :global(.changelog-latest:target) { background: var(--bg-alt); }
  .generated :global(.changelog-release), .generated :global(.changelog-latest) { scroll-margin-top: 96px; }
</style>
