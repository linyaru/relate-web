---
// Interim: renders the legacy page body, with the shared Header component and base.css
// swapped in. Replace with real section components as pieces are extracted from
// src/legacy/index.html (see CLAUDE.md).
import legacy from '../legacy/index.html?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import LoopDemo from '../components/LoopDemo.astro';
import Diagram from '../components/Diagram.astro';
import Quickstart from '../components/Quickstart.astro';
import Chapters from '../components/Chapters.astro';
import Cta from '../components/Cta.astro';
import Community from '../components/Community.astro';
import '../styles/base.css';
const html = legacy.replace(/^<!DOCTYPE html>\s*/i, '');
const [before, rest] = html.split('<!--SITE-HEADER-->');
const [top, rest2] = rest.split('<!--SITE-HERO-->');
const [between, after] = rest2.split('<!--SITE-FOOTER-->');
---
<Fragment set:html={before} /><Header /><Fragment set:html={top} /><Hero /><LoopDemo /><Diagram /><Quickstart /><Chapters /><Fragment set:html={between} /><Community /><Cta /><Footer play /><Fragment set:html={after} />
