---
// "Got feedback?" — a disclosure that opens a page's GitHub Discussion (giscus, mapped by
// pathname). giscus loads the first time it is opened, so the page makes no third-party
// request by default. Without ids (src/lib/giscus.ts) it links to a new issue.
import { GISCUS, giscusReady } from '../lib/giscus.ts';

const issue = `https://github.com/${GISCUS.repo}/issues/new`;
---
<details class="fb" id="feedback" data-pagefind-ignore>
  <summary><span class="fb-t">Got feedback?</span><span class="fb-s">Corrections and suggestions are welcome.</span></summary>
  <div class="fb-in">
    {giscusReady ? (
      <>
        <p>Sign in with GitHub to comment. It's a public discussion about this page.</p>
        <div class="fb-box" data-giscus-box></div>
        <noscript><a class="fb-link" href={issue} target="_blank" rel="noopener">Open an issue on GitHub<span class="sr-only"> (opens in new tab)</span></a></noscript>
        <script is:inline define:vars={{ GISCUS }}>
          (function () {
            var d = document.currentScript.closest('details');
            var host = d && d.querySelector('[data-giscus-box]');
            if (!host) return;
            var theme = function () {
              var t = document.documentElement.dataset.theme;
              if (t === 'light' || t === 'dark') return t;
              return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
            };
            var send = function () {
              var f = host.querySelector('iframe.giscus-frame');
              if (f && f.contentWindow) f.contentWindow.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
            };
            var load = function () {
              d.removeEventListener('toggle', onToggle);
              var s = document.createElement('script');
              s.src = 'https://giscus.app/client.js';
              s.async = true;
              s.crossOrigin = 'anonymous';
              var set = { 'data-repo': GISCUS.repo, 'data-repo-id': GISCUS.repoId, 'data-category': GISCUS.category,
                'data-category-id': GISCUS.categoryId, 'data-mapping': 'pathname', 'data-strict': '1',
                'data-reactions-enabled': '0', 'data-emit-metadata': '0', 'data-input-position': 'top',
                'data-theme': theme(), 'data-lang': 'en', 'data-loading': 'lazy' };
              for (var k in set) s.setAttribute(k, set[k]);
              host.appendChild(s);
              new MutationObserver(send).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
              window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', send);
            };
            var onToggle = function () { if (d.open) load(); };
            d.addEventListener('toggle', onToggle);
            if (d.open) load();
          })();
        </script>
      </>
    ) : (
      <a class="fb-link" href={issue} target="_blank" rel="noopener">Open an issue on GitHub<span class="sr-only"> (opens in new tab)</span></a>
    )}
  </div>
</details>

<style>
  .fb { margin: 48px 0 8px; border-top: 1px solid var(--line); user-select: text; -webkit-user-select: text; }
  .fb summary { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; padding: 16px 0; cursor: pointer; list-style: none; }
  .fb summary::-webkit-details-marker { display: none; }
  .fb summary::before { content: ''; flex: none; align-self: center; width: 0; height: 0; border-style: solid; border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent currentColor; transition: transform .15s; color: var(--ink-muted, var(--ink)); }
  .fb[open] summary::before { transform: rotate(90deg); }
  .fb summary:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .fb-t { font-weight: 600; font-size: 16px; color: var(--ink); }
  .fb-s { font-size: 14px; color: var(--ink-muted, var(--ink)); }
  .fb-in { padding-bottom: 16px; }
  .fb-in p { margin: 0 0 12px; font-size: 14px; color: var(--ink-muted, var(--ink)); }
  .fb-link { display: inline-block; font-weight: 600; font-size: 14px; color: var(--ink);
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 9px 16px; text-decoration: none; }
  .fb-link:hover { border-color: var(--brand); }
  @media (prefers-reduced-motion: reduce) { .fb summary::before { transition: none; } }
</style>
