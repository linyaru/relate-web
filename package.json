{
  "name": "relate-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8765",
    "dev:playground": "npm --prefix playground run dev --",
    "build": "astro build && npm run build:search && npm run build:playground",
    "build:site": "astro build && npm run build:search",
    "build:search": "pagefind --site dist --glob \"{docs,cookbook}/**/*.html\"",
    "build:playground": "node scripts/build-playground.mjs",
    "build:playground:force": "node scripts/build-playground.mjs --force",
    "preview": "astro preview --host 127.0.0.1 --port 8765",
    "check": "astro check",
    "discovery:fetch": "bash scripts/fetch-discovery.sh",
    "check:playground": "npm --prefix playground run typecheck",
    "cookbook:check": "node scripts/cookbook.ts",
    "cookbook:record": "node scripts/cookbook.ts --record",
    "cookbook:test": "node --test \"src/lib/cookbook/*.test.ts\"",
    "cookbook:browser": "node scripts/cookbook-browser.ts",
    "cookbook:diagrams": "node scripts/diagrams/render.mjs --collection cookbook",
    "cookbook:codebase-data": "node scripts/codebase-recipe-data.ts",
    "docs:test": "node --test \"src/lib/docs/*.test.ts\"",
    "docs:diagrams": "node scripts/diagrams/render.mjs --collection docs",
    "docs:check": "node scripts/docs.ts",
    "docs:record": "node scripts/docs.ts --record",
    "docs:lint": "node scripts/docs.ts --lint",
    "docs:cli-check": "node scripts/docs-cli-check.ts",
    "docs:graph": "node scripts/docs-graph.ts",
    "docs:embeddings": "node scripts/docs-embeddings.ts",
    "docs:negotiation-check": "node scripts/docs-negotiation-check.ts",
    "docs:samples": "node scripts/docs-samples.ts",
    "docs:evals": "node scripts/docs-evals.ts",
    "skill:sync": "node scripts/skill-sync.ts",
    "skills:record": "node scripts/skills-record.ts",
    "adr:check": "node scripts/adr-check.ts",
    "ci": "bash scripts/ci-local.sh",
    "vale:install": "bash scripts/vale/install.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@huggingface/tokenizers": "0.2.0",
    "@neo4j-nvl/base": "1.2.2",
    "@neo4j-nvl/interaction-handlers": "1.2.2",
    "astro": "^7.4.7",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-html": "^9.0.6",
    "markdown-it": "^14.3.3",
    "mdast-util-to-string": "^4.0.0",
    "onnxruntime-web": "1.30.0",
    "pagefind": "^1.6.0",
    "parse5": "^8.1.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/d3-force": "3.0.10",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "d3-force": "3.0.0",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-mdx-jsx": "^3.2.1",
    "typescript": "^6.0.3"
  }
}
