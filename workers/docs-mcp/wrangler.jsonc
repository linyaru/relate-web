// The hosted docs MCP server (README.md). Runs locally with `npm run dev`
// (wrangler dev --local on 127.0.0.1:8787) and needs no Cloudflare login for that.
// At launch, deploy-cf.yml runs `npm run bundle` after the site build and then
// `wrangler deploy`, which binds the Worker to relatedb.ai/mcp on the zone
// configured then (ADR-0012). Host checks: the Agents SDK accepts only
// localhost names locally; on the route, Cloudflare routing decides.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relate-docs-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // agents/mcp/server uses node:async_hooks (AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "send_metrics": false,
  "routes": [{ "pattern": "relatedb.ai/mcp", "zone_name": "relatedb.ai" }],
  "rules": [{ "type": "Text", "globs": ["**/*.cypher", "**/*.txt"], "fallthrough": true }],
  // Per IP: 20 requests per 10 s. Per IP and tool: a cost budget of 120 units
  // per 60 s (src/limits.ts holds the same numbers and the costs). Both count
  // per Cloudflare location; wrangler dev simulates them.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "4101", "simple": { "limit": 20, "period": 10 } },
    { "name": "RL_COST", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } }
  ],
  // Workers Logs keeps only what the Worker writes (src/log.ts, and the error
  // line in src/index.ts that names an exception's type and the path):
  // invocation logs, which carry Cloudflare's request metadata, are off.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  // Workers AI, for the hybrid lane of search_docs (ADR-0028): the query is
  // embedded with @cf/baai/bge-small-en-v1.5 (cls pooling). Always remote:
  // there is no local simulation, and `wrangler dev` needs a Cloudflare login
  // or CLOUDFLARE_API_TOKEN for it (without one it exits), so `npm run dev`
  // and the checks run `wrangler dev --local`, where every call on the
  // binding throws "Binding AI needs to be run remotely" and search_docs
  // answers full-text only ("retrieval": "full-text", with a retrieval_note).
  "ai": { "binding": "AI", "remote": true },
  "dev": { "port": 8787, "ip": "127.0.0.1" }
}
