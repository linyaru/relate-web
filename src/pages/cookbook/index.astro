---
// The cookbook's index: every recipe in one grid, filterable by category, level and a search word.
import Cookbook from '../../layouts/Cookbook.astro';
import { pixels } from '../../lib/cookbook/pixel-icons.ts';
import { byCategory } from '../../lib/cookbook/render.ts';
import { cookbook } from '../../lib/cookbook/site.ts';
import { collectionGraph } from '../../lib/seo.ts';

const { pages } = await cookbook();
const recipes = byCategory(pages.map((p) => p.recipe)).flatMap((g) => g.recipes);
const categories = [...new Set(recipes.map((r) => r.front.category))];
const cbTitle = 'Cookbook';
const cbDescription = 'Runnable Relate recipes: entity resolution, geospatial tools, dependency analysis, hybrid search, agent memory, and more, each running in your browser.';
const levels = ['Beginner', 'Intermediate', 'Advanced'].filter((l) => recipes.some((r) => r.front.level === l));
---
<Cookbook title={cbTitle} description={cbDescription} jsonld={[collectionGraph(cbTitle, cbDescription, '/cookbook/')]}>
  <header class="cb-hero">
    <p class="eyebrow"><a href="/">relate</a> / cookbook</p>
    <h1>Cookbook</h1>
    <p class="lede">
      Recipes that solve one problem each, with a small dataset and plain Cypher. Every step runs in your
      browser on Relate compiled to WebAssembly, and every recorded result is checked against the engine in CI.
    </p>
  </header>

  <form class="cb-filters" role="search" aria-label="Filter recipes" onsubmit="return false">
    <label class="cb-sel">
      <span class="sr-only">Category</span>
      <select id="cb-category">
        <option value="">All categories</option>
        {categories.map((c) => <option>{c}</option>)}
      </select>
      <svg class="cb-px" viewBox="0 0 5 3" width="10" height="6" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><path d={pixels('down').d} /></svg>
    </label>
    <label class="cb-sel">
      <span class="sr-only">Level</span>
      <select id="cb-level">
        <option value="">All levels</option>
        {levels.map((l) => <option>{l}</option>)}
      </select>
      <svg class="cb-px" viewBox="0 0 5 3" width="10" height="6" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><path d={pixels('down').d} /></svg>
    </label>
    <label class="cb-search">
      <svg class="cb-px" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><path d={pixels('Search with context').d} /></svg>
      <span class="sr-only">Search recipes</span>
      <input id="cb-query" type="search" placeholder="Search" autocomplete="off" />
      <kbd aria-hidden="true">/</kbd>
    </label>
  </form>

  <h2 class="cb-count" id="cb-count" aria-live="polite">All recipes</h2>
  <ul class="cb-grid" id="cb-grid">
    {recipes.map((r) => {
      const icon = pixels(r.front.category);
      return (
        <li data-category={r.front.category} data-level={r.front.level} data-text={`${r.front.title} ${r.front.summary} ${r.front.category} ${r.front.level}`.toLowerCase()}>
          <a class="cb-card" href={`/cookbook/${r.slug}/`}>
            <svg class="cb-px" viewBox={`0 0 ${icon.w} ${icon.h}`} width={icon.w * 2} height={icon.h * 2} shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><path d={icon.d} /></svg>
            <span class="cb-title">{r.front.title}</span>
            <span class="cb-sum">{r.front.summary}</span>
            <span class="cb-meta">{r.front.category} <i>/</i> {r.front.level}</span>
          </a>
        </li>
      );
    })}
    <li class="cb-add-li" id="cb-add">
      <div class="cb-card cb-add">
        <svg class="cb-plus" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
        <span class="cb-title">Share a recipe</span>
        <span class="cb-sum">Found a pattern that works for your agent? Add it to the cookbook.</span>
        <a class="cb-add-btn" href="https://github.com/relatedb/relate-web" target="_blank" rel="noopener">Add a recipe<span aria-hidden="true">&nbsp;&#8599;</span><span class="sr-only"> (opens in new tab)</span></a>
      </div>
    </li>
  </ul>
  <p class="cb-empty" id="cb-empty" hidden>No recipes match. Try another word or category.</p>

  
</Cookbook>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const category = $<HTMLSelectElement>('cb-category');
  const level = $<HTMLSelectElement>('cb-level');
  const query = $<HTMLInputElement>('cb-query');
  const count = $('cb-count');
  const empty = $('cb-empty');
  const items = [...document.querySelectorAll<HTMLElement>('#cb-grid > li[data-category]')];
  const add = $('cb-add');

  function apply() {
    const q = query.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const ok =
        (!category.value || li.dataset.category === category.value) &&
        (!level.value || li.dataset.level === level.value) &&
        (!q || (li.dataset.text ?? '').includes(q));
      li.hidden = !ok;
      if (ok) shown++;
    }
    const filtered = Boolean(q || category.value || level.value);
    count.textContent = filtered ? `${shown} ${shown === 1 ? 'recipe' : 'recipes'}` : 'All recipes';
    empty.hidden = shown > 0;
    add.hidden = filtered;
  }
  for (const el of [category, level]) el.addEventListener('change', apply);
  query.addEventListener('input', apply);
  document.addEventListener('keydown', (e) => {
    const tag = document.activeElement?.tagName ?? '';
    if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(tag)) {
      e.preventDefault();
      query.focus();
    }
  });
</script>
