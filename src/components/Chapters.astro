---
// Home "Why relate" chapters: a sticky chapter list beside three blocks (Built for agents,
// Memory with structure, Zero to querying). The languages hub is drawn at build time; the only
// script is the chapter list's scroll tracking and the lifeline animation.
import { MASCOT, lux } from '../lib/home/brand-art.ts';
import { LANG_LOGOS } from '../lib/home/lang-logos.ts';

const ways = [
  { icon: lux('wand-sparkles', 40, 1.5), h: 'Agent skill', p: 'Teaches your coding agent to write Cypher for relate.' },
  { icon: lux('plug', 40, 1.5), h: 'MCP endpoint', p: 'Lets agents that speak MCP connect without glue code.' },
  { icon: lux('terminal', 40, 1.5), h: 'Command line', p: 'Create, load and query a database right from the shell.' },
  { icon: lux('package', 40, 1.5), h: 'Libraries', p: 'Embed relate in your own application, in your language.' },
];
const fx = [
  { icon: lux('file-text', 28, 1.6).replace('class="ic lux"', 'class="fxi"'), h: 'Facts, not loose text', p: 'Decisions, people and documents become facts you can query.' },
  { icon: lux('network', 28, 1.6).replace('class="ic lux"', 'class="fxi"'), h: 'Relationships and similarity together', p: 'One Cypher statement can combine both.' },
];
const chapters = [
  { id: 'how', label: 'Built for agents' },
  { id: 'facts', label: 'Memory with structure' },
  { id: 'first', label: 'Zero to querying' },
];

// Memory-with-structure chips: nodes (light) and relationships (dark) in three marquee rows.
const rows: { rv: boolean; items: [string, 'n' | 'r'][] }[] = [
  { rv: false, items: [['Person Maya','n'],['DECIDED','r'],['Topic Pricing','n'],['DEPENDS_ON','r'],['Launch Q3','n'],['PART_OF','r'],['Task Launch email','n'],['OWNS','r'],['Page Pricing','n']] },
  { rv: true, items: [['notes.md','n'],['MENTIONS','r'],['Person Maya','n'],['AFFECTS','r'],['Decision Annual plan','n'],['ABOUT','r'],['orders.csv','n'],['MENTIONS','r'],['thread.json','n']] },
  { rv: false, items: [['OWNS','r'],['Page Pricing','n'],['DEPENDS_ON','r'],['Launch Q3','n'],['DECIDED','r'],['Person Maya','n'],['PART_OF','r'],['Topic Pricing','n'],['AFFECTS','r']] },
];

// The languages hub: eight full-colour language logos on neutral tiles, wired to the relate mark by
// elbow routes with a pulse that flows towards it.
const L: [string, string, number, number][] = [
  ['rs', 'RS', 200, 50], ['py', 'PY', 320, 50], ['js', 'JS', 460, 140], ['wa', 'WA', 460, 260],
  ['go', 'GO', 320, 340], ['jv', 'JV', 200, 340], ['sf', 'SF', 60, 260], ['c', 'C', 60, 140],
];
const T = ['M200 76V106L232 138V172', 'M320 76V106L288 138V172', 'M436 140H400L364 176H290', 'M436 260H400L364 224H296', 'M320 316V294L288 262V226', 'M200 316V294L232 262V226', 'M84 260H120L156 224H222', 'M84 140H120L156 176H230'];
const TS = 56;
let hub = '';
T.forEach((d, i) => { hub += `<path class="hb-l" d="${d}"/><path class="hb-f" pathLength="100" d="${d}" style="animation-delay:${(i * 0.22).toFixed(2)}s"/>`; });
hub += `<g transform="translate(205 150) scale(.19)">${MASCOT}</g>`;
for (const [k, code, x, y] of L) {
  const g = LANG_LOGOS[k], vb = g.vb, m = code === 'GO' ? 46 : 34, sc = Math.min(m / vb[2], m / vb[3]), w = vb[2] * sc, h = vb[3] * sc;
  hub += `<g class="hb-g" role="img" aria-label="${g.n}"><title>${g.n}</title><rect class="hb-b" x="${x - TS / 2}" y="${y - TS / 2}" width="${TS}" height="${TS}" rx="10"/><svg x="${x - w / 2}" y="${y - h / 2}" width="${w}" height="${h}" viewBox="${vb.join(' ')}" aria-hidden="true">${g.i}</svg></g>`;
}
const hubSvg = `<svg class="hubsvg" viewBox="0 16 520 358" role="img" aria-label="relate is available in Rust, Python, JavaScript, WebAssembly, Go, Java, Swift and C">${hub}</svg>`;
---
<div class="chapters" id="chapters">
  <aside class="toc" id="toc" aria-label="About relate">
    <ol>
      <li class="toc-l" aria-hidden="true">Why relate</li>
      {chapters.map((c, i) => <li><a href={`#${c.id}`} aria-current={i === 0 ? 'true' : undefined}>{c.label}</a></li>)}
    </ol>
  </aside>
  <div class="chs">

    <section class="chap" id="how" aria-labelledby="h-how">
      <div class="mb-t">
        <h2 id="h-how">Built for agents, wherever your agent runs.</h2>
        <p class="lede">relate is a library inside your application. Your agent writes Cypher and relate answers with the results. Use the interface that fits your build.</p>
      </div>
      <div class="ways">
        {ways.map((w) => <div><span class="wic" set:html={w.icon} /><h3>{w.h}</h3><p>{w.p}</p></div>)}
      </div>
      <div class="duo">
        <div>
          <h3>Your language, one library</h3>
          <p>The same relate in Rust, Python, JavaScript, WebAssembly, Go, Java, Swift and C. Pick the one your application is written in.</p>
          <div class="lvis" set:html={hubSvg} />
        </div>
        <div>
          <h3>No server to run</h3>
          <p>relate starts when your application does and stops when it stops. Nothing to host, nothing to keep running.</p>
          <div class="life" aria-hidden="true" translate="no">
            <div class="lh"><span>Your app</span><em data-s="a">stopped</em></div><div class="lr" data-r="a"></div>
            <div class="lh"><span>relate</span><em data-s="b">stopped</em></div><div class="lr" data-r="b"></div>
            <div class="la"><span>Start</span><span>Query</span><span>Stop</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="chap" id="facts" aria-labelledby="h-facts">
      <div class="fx-m">
        <div class="pn">
          <div class="chips" aria-hidden="true" translate="no">
            {rows.map((r) => (
              <div class="chip-row"><div class={`chip-tr${r.rv ? ' rv' : ''}`}>{r.items.map(([t, k]) => <span class={`ch ${k}`}>{t}</span>)}</div></div>
            ))}
          </div>
          <div class="cq"><div class="code" translate="no"><span class="k">MATCH</span> (<span class="n">:Person</span> &#123;name: <span class="s">'Maya'</span>&#125;)-[<span class="r">:DECIDED</span>]-&gt;(<span class="n">:Topic</span>){'\n'}      -[<span class="r">:DEPENDS_ON</span>]-&gt;(<span class="n">:Launch</span>){'\n'}<span class="k">RETURN</span> <span class="n">Launch</span>.name</div></div>
        </div>
      </div>
      <div class="fx-t">
        <h2 id="h-facts">Memory with structure.</h2>
        <p class="lede">Raw data becomes connected facts, so your agent can follow how people, decisions and documents relate. Relationships and similarity answer in one query.</p>
        <div class="fx-p">
          {fx.map((f) => <div><Fragment set:html={f.icon} /><h3>{f.h}</h3><p>{f.p}</p></div>)}
        </div>
      </div>
    </section>

    <section class="chap" id="first" aria-labelledby="h-first">
      <div class="fs-t">
        <h2 id="h-first">Zero to querying in seconds.</h2>
        <p class="lede">Install the open-source package, create a database and start running your first query. No account, no instance and no server to deploy.</p>
        <div class="tiny"><div class="code" translate="no"><span class="ps">$</span>curl -sSfL https://relatedb.ai/install.sh | bash{'\n'}<span class="ps">$</span>relate --mode envelope "<span class="k">RETURN</span> 1 <span class="k">AS</span> ok"{'\n'}<span class="dm">&#123;"columnTypes":["INTEGER"],"columns":["ok"],"notifications":[],"rows":[&#123;"ok":1&#125;],"truncated":false&#125;</span></div></div>
      </div>
      <div class="fs-m">
        <p class="big">Cypher you already know.</p>
        <p class="sub">relate speaks the openCypher language and is tested against the openCypher TCK, the language contract. Where it differs from Neo4j, the docs say so.</p>
        <a class="link" href="/docs/reference/cypher/differences-from-neo4j/">Read the differences<span aria-hidden="true">&nbsp;&#8599;</span></a>
      </div>
    </section>

  </div>
</div>

<style>
  .chapters {
    display: grid; grid-template-columns: 220px minmax(0, 1fr); align-items: stretch;
    max-width: var(--page-w); margin: 0 auto; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    background: var(--surface-0);
  }
  .toc { border-right: 1px solid var(--line); }
  .toc ol { position: sticky; top: calc(var(--header-h) + 20px); list-style: none; margin: 0; padding: 20px 0; }
  .toc-l { padding: 0 20px 14px; font: 500 12px/16px var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); }
  .toc a {
    position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: 8px 20px;
    color: var(--ink-muted); font-size: 14px; line-height: 20px; text-decoration: none; transition: color .15s, background-color .15s;
  }
  .toc a::after { content: '\2192'; opacity: 0; transform: translateX(-4px); transition: opacity .15s, transform .15s; }
  .toc a:hover { color: var(--ink); background: var(--surface-2); }
  .toc a[aria-current] { color: var(--ink); background: var(--surface-2); font-weight: 500; }
  .toc a[aria-current]::after { opacity: 1; transform: none; }
  .toc a:focus-visible { outline: 0; box-shadow: inset 0 0 0 2px var(--focus); }
  .chs { min-width: 0; }
  .chap { min-width: 0; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 8px); }
  .chap:first-child { border-top: 0; }
  h2 { margin: 0; font: 500 clamp(24px, 2.4vw, 36px) / 1.1 var(--font); letter-spacing: -.03em; color: var(--ink); text-wrap: balance; }
  h3 { margin: 0; font: 600 20px/28px var(--font); letter-spacing: -.02em; color: var(--ink); }
  .lede { margin: 0; color: var(--ink-muted); font-size: 17px; line-height: 28px; }

  /* Built for agents */
  #how .mb-t { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 64px; align-items: center; padding: 72px 40px; }
  .ways { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .ways > div { padding: 56px 40px 64px; }
  .ways :global(.wic) { display: block; width: 40px; height: 40px; margin-bottom: 40px; color: var(--ink); }
  .ways :global(svg.lux) { display: block; flex: none; filter: none; color: var(--ink); }
  .ways p, .duo p { margin: 10px 0 0; color: var(--ink-muted); font-size: 15px; line-height: 24px; }
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .duo > div { padding: 56px 40px 64px; }
  .duo > div + div { border-left: 1px solid var(--line); }
  .lvis { margin-top: 32px; }
  .lvis :global(svg.hubsvg) { display: block; width: 100%; height: auto; }
  .lvis :global(.hb-l) { fill: none; stroke: var(--line-strong); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lvis :global(.hb-f) { fill: none; stroke: #F96746; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 14 100; stroke-dashoffset: 14; animation: hbflow 2.2s linear infinite; }
  @keyframes hbflow { 0% { stroke-dashoffset: 14; } 70%, 100% { stroke-dashoffset: -100; } }
  .lvis :global(.hb-b) { fill: var(--surface-2); stroke: var(--line-strong); stroke-width: 1.25; }
  :global(:root[data-theme="light"]) .lvis :global([aria-label^="Rust"] path) { fill: #181414; }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme="dark"])) .lvis :global([aria-label^="Rust"] path) { fill: #181414; } }
  .life { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; margin-top: 32px; padding: 20px; border: 1px solid var(--line); background: var(--surface-0); font: 400 12px/16px var(--mono); color: var(--ink-muted); }
  .lh { display: flex; justify-content: space-between; margin: 16px 0 0; font: 500 11px/14px var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink); }
  .lh:first-child { margin-top: 0; }
  .lh :global(em) { font-style: normal; color: var(--ink-muted); }
  .lh :global(em.on) { color: var(--brand); }
  .lr { display: grid; grid-template-columns: repeat(36, 1fr); gap: 2px; }
  .lr :global(i) { aspect-ratio: 1; background: var(--line); transition: background-color .2s; }
  .lr :global(i.on) { background: var(--brand); }
  .la { display: flex; justify-content: space-between; margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--line); font: 400 10px/14px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); }

  /* Memory with structure */
  #facts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 56px; align-items: center; padding: 72px 40px; }
  .fx-m { min-width: 0; }
  .pn { overflow: hidden; border: 1px solid var(--line-strong); padding: 56px 0 56px; display: flex; flex-direction: column; gap: 56px; background: var(--surface-0); }
  .chips { display: flex; flex-direction: column; gap: 14px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .chip-row { display: flex; overflow: hidden; }
  .chip-tr { display: flex; gap: 12px; flex: none; padding-right: 12px; animation: mq 60s linear infinite; }
  .chip-tr.rv { animation-direction: reverse; animation-duration: 75s; }
  .chip-row:nth-child(3) .chip-tr { animation-duration: 90s; }
  @keyframes mq { to { transform: translateX(-100%); } }
  .ch { flex: none; padding: 10px 18px; background: #fff; color: #0A1114; font: 500 14px/20px var(--mono); white-space: nowrap; }
  .ch.r { background: #0A1114; color: #E9EFF1; letter-spacing: .04em; }
  .cq { margin: 0 auto; width: calc(100% - 80px); max-width: 560px; border: 1px solid var(--line); background: var(--surface-0); box-shadow: var(--ui-shadow); }
  .code { padding: 24px 28px; background: var(--term-bg); color: var(--term-ink); font: 400 13px/22px var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  .code :global(.k), .code .k { color: var(--hl, var(--brand)); }
  .code :global(.ps), .code .ps { color: var(--term-dim); margin-right: 10px; user-select: none; }
  .code :global(.dm), .code .dm { color: var(--term-dim); }
  .code .n { color: var(--md, var(--ink)); }
  .code .r { color: var(--hl, var(--ink)); }
  .code .s { color: var(--sh, var(--ink)); }
  .fx-t .lede { margin-top: 20px; }
  .fx-p { display: grid; gap: 32px; margin-top: 48px; }
  .fx-p :global(.fxi) { display: block; box-sizing: content-box; width: 22px; height: 22px; padding: 11px; margin: 0 0 20px; border: 1px solid var(--line-strong); border-radius: 10px; background: var(--surface-2); color: var(--ink); }
  .fx-p h3 { font: 600 16px/24px var(--font); letter-spacing: -.01em; margin: 0 0 6px; }
  .fx-p p { margin: 0; color: var(--ink-muted); font-size: 14px; line-height: 22px; }

  /* Zero to querying */
  #first { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .fs-t { padding: 56px 40px 64px; }
  .fs-t .lede { margin-top: 20px; }
  .tiny { margin-top: 48px; max-width: 460px; border: 1px solid var(--line); box-shadow: var(--ui-shadow); background: var(--term-bg); }
  .tiny .code { padding: 24px; font-size: 12px; }
  .fs-m { display: flex; flex-direction: column; justify-content: flex-end; padding: 56px 40px 64px; border-left: 1px solid var(--line); }
  .fs-m .big { margin: 0; font: 600 clamp(40px, 5.2vw, 72px) / .98 var(--font); letter-spacing: -.05em; color: var(--ink); max-width: 9ch; }
  .fs-m .sub { margin: 28px 0 0; max-width: 42ch; color: var(--ink-muted); font-size: 16px; line-height: 26px; }
  .link { align-self: flex-start; margin-top: 16px; color: var(--ink); font-size: 15px; text-underline-offset: 4px; }

  @media (max-width: 1180px) {
    .ways > div, .duo > div { padding: 40px 28px 48px; }
    #how .mb-t { padding: 56px 28px; }
  }
  @media (max-width: 900px) {
    .chapters { display: block; }
    .toc { position: sticky; top: var(--header-h); z-index: 20; border-right: 0; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--surface-0) 92%, transparent); backdrop-filter: blur(14px); }
    .toc ol { position: static; display: flex; padding: 0 16px; overflow-x: auto; scrollbar-width: none; }
    .toc ol::-webkit-scrollbar { display: none; }
    .toc li { flex: none; }
    .toc-l, .toc a::after { display: none; }
    .toc a { min-height: 48px; padding: 0 12px; background: none !important; border-bottom: 2px solid transparent; white-space: nowrap; }
    .toc a[aria-current] { border-bottom-color: var(--ink); }
    #how .mb-t { display: block; padding: 40px 24px; }
    #how .mb-t .lede { margin-top: 16px; }
    .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ways > div { padding: 32px 24px 40px; border-top: 1px solid var(--line); }
    .ways > div:nth-child(-n+2) { border-top: 0; }
    .duo { grid-template-columns: minmax(0, 1fr); }
    .duo > div { padding: 32px 24px 40px; }
    .duo > div + div { border-left: 0; border-top: 1px solid var(--line); }
    #facts { display: block; padding: 40px 24px; }
    .fx-t { margin-top: 40px; }
    #first { display: block; }
    .fs-t, .fs-m { padding: 40px 24px; }
    .fs-m { border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .ways { grid-template-columns: minmax(0, 1fr); }
    .ways > div { border-left: 0 !important; border-top: 1px solid var(--line) !important; }
    .ways > div:first-child { border-top: 0 !important; }
    .cq { width: calc(100% - 32px); }
  }
  @media (prefers-reduced-motion: reduce) { .chip-tr { animation: none; } .lvis :global(.hb-f) { animation: none; opacity: 0; } }
</style>

<script>
  // Chapter list: highlight the chapter in view and scroll to it on click.
  const secs = [...document.querySelectorAll<HTMLElement>('#chapters .chap')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#toc a')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur = -1;
  const set = (i: number) => {
    if (i === cur) return;
    cur = i;
    links.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  };
  links.forEach((a, i) => a.addEventListener('click', (e) => {
    e.preventDefault();
    secs[i].scrollIntoView({ block: 'start', behavior: reduced ? 'auto' : 'smooth' });
    history.replaceState(null, '', `#${secs[i].id}`);
  }));
  const pick = () => {
    let best = 0;
    const y = innerHeight * 0.35;
    secs.forEach((s, i) => { if (s.getBoundingClientRect().top <= y) best = i; });
    set(best);
  };
  addEventListener('scroll', pick, { passive: true });
  addEventListener('resize', pick);
  pick();

  // Lifeline: relate lives exactly as long as the application.
  const life = document.querySelector<HTMLElement>('.life');
  if (life) {
    const C = 36;
    const sa = life.querySelector<HTMLElement>('[data-s=a]')!, sb = life.querySelector<HTMLElement>('[data-s=b]')!;
    life.querySelectorAll('.lr').forEach((r) => { for (let i = 0; i < C; i++) r.appendChild(document.createElement('i')); });
    const A = [...life.querySelectorAll<HTMLElement>('[data-r=a] i')], B = [...life.querySelectorAll<HTMLElement>('[data-r=b] i')];
    const paint = (t: number) => {
      for (let i = 0; i < C; i++) {
        A[i].classList.toggle('on', i >= 4 && i <= Math.min(t, 31));
        B[i].classList.toggle('on', i >= 4 && i <= Math.min(t - 1, 31));
      }
      const ra = t >= 4 && t <= 36, rb = t >= 5 && t <= 36;
      sa.textContent = ra ? 'running' : 'stopped';
      sb.textContent = rb ? 'running' : 'stopped';
      sa.classList.toggle('on', ra);
      sb.classList.toggle('on', rb);
    };
    if (reduced) paint(31);
    else {
      let t = 0, iv: ReturnType<typeof setInterval> | undefined;
      new IntersectionObserver((es) => {
        clearInterval(iv);
        if (es[0].isIntersecting) iv = setInterval(() => { t = (t + 1) % 46; paint(t > 36 ? -1 : t); }, 110);
      }).observe(life);
    }
  }
</script>
