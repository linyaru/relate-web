---
// Site-wide top bar: a bordered grid of cells (lockup, links, the call to action). Used by every
// page (home and sections) so navigation stays consistent. The theme switch is in the footer.
interface Props {
  /** Where the Playground link goes: a recipe page opens its recipe there (`/playground/#recipe=<slug>`). */
  playgroundHref?: string;
}
const { playgroundHref = '/playground/' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// A section link is current on the section's own pages too (/cookbook/<slug>/).
const isCurrent = (href: string) => {
  if (href.includes('#') || /^https?:/.test(href)) return false;
  const h = href.replace(/\/$/, '') || '/';
  return path === h || (h !== '/' && path.startsWith(`${h}/`));
};
const links = [
  { href: '/#quickstart', label: 'Quickstart' },
  { href: '/#examples', label: 'Examples' },
  { href: '/#reference', label: 'Reference' },
  { href: '/#extensions', label: 'Extensions' },
  { href: '/docs', label: 'Docs' },
  { href: '/blog', label: 'Blog' },
  { href: '/cookbook/', label: 'Cookbook' },
  { href: 'https://github.com/relatedb/relate', label: 'GitHub', external: true },
  {
    href: playgroundHref,
    label: 'Playground',
    external: true,
    icon: true,
    title: playgroundHref === '/playground/' ? undefined : 'Open this recipe in the playground',
  },
];
---
<a class="skip" href="#main">Skip to content</a>
<header class="nav" id="top">
  <div class="nav-in">
    <a class="lockup" href="/" aria-label="relate, home" translate="no">
      <svg class="lockup-mark" viewBox="0 0 49.5 10" aria-hidden="true"><use href="/lockup.svg#lockup" width="49.5" height="10" /></svg>
    </a>
    <nav class="nav-links" id="topNav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} title={'title' in l ? l.title : undefined} aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}{l.icon && <span aria-hidden="true">&nbsp;&#8599;</span>}{l.external && <span class="sr-only"> (opens in new tab)</span>}
        </a>
      ))}
    </nav>
    <div class="nav-right">
      <a class="nav-cta" href="/#quickstart">Get started</a>
      <button class="menu-btn" id="navToggle" type="button" aria-label="Open menu" aria-controls="topNav" aria-expanded="false"><span><i></i><i></i></span></button>
    </div>
  </div>
</header>

<script>
  // ---------- Sticky header shadow ----------
  const header = document.getElementById('top') as HTMLElement;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ---------- Mobile nav toggle ----------
  const navToggle = document.getElementById('navToggle');
  const topNav = document.getElementById('topNav');
  if (navToggle && topNav) {
    const closeNav = () => {
      topNav.classList.remove('open');
      navToggle.setAttribute('aria-expanded', 'false');
      navToggle.setAttribute('aria-label', 'Open menu');
    };
    navToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = topNav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    topNav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') closeNav();
    });
    document.addEventListener('click', (e) => {
      if (!topNav.contains(e.target as Node) && !navToggle.contains(e.target as Node)) closeNav();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeNav();
    });
  }
</script>
