---
// Shell for the docs section (/docs/ and /docs/<path>/): the shared Base
// layout with the docs header (full width, ruled; menu toggle on phones,
// search), the generated sidebar, the content column (indexed by Pagefind) and the "On this page"
// column (ADR-0003). Every page is complete without JavaScript; the script
// adds copy buttons, tabs, the phone menu and search.
import Base from './Base.astro';
import DocsHeader from '../components/docs/DocsHeader.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import Toc from '../components/docs/Toc.astro';
import { CANONICAL_ORIGIN } from '../lib/cookbook/links.ts';
import type { NavGroup } from '../lib/docs/nav.ts';
import '../styles/cookbook.css';
import '../styles/docs-chrome.css';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  nav: NavGroup[];
  /** The current page id ('' for the landing). */
  current: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** The page's markdown twin, for <link rel="alternate">. */
  twinHref?: string;
  /** The docs landing: the regular site header and no sidebar. */
  landing?: boolean;
}
const { title, description, nav, current, headings = [], twinHref, landing = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), CANONICAL_ORIGIN).href;
---
<Base title={title} description={description} chrome={landing ? 'site' : 'docs'}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    {twinHref && <link rel="alternate" type="text/markdown" href={twinHref} title="This page as markdown" />}
    <link rel="describedby" href="/docs/llms.txt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />
    <slot name="head" />
  </Fragment>
  {!landing && <DocsHeader section="Docs" slot="header" />}
  <div class:list={['docs-shell', landing ? 'is-landing' : 'chrome-shell']}>
    {landing ? (
      <article class="docs-main" data-pagefind-body>
        <slot />
      </article>
    ) : (
      <div class={`docs-grid${headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 2 ? ' has-toc' : ''}`}>
        <nav class="docs-sidebar" id="docsNav" aria-label="Docs">
          <Sidebar nav={nav} current={current} />
        </nav>
        <article class="docs-main" data-pagefind-body>
          <slot />
        </article>
        <Toc headings={headings} />
      </div>
    )}
  </div>
</Base>

<script>
  import '../scripts/docs/chrome.ts';

  // ---------- Copy: code blocks, and a page's markdown ----------
  const flash = (btn: HTMLButtonElement, text: string) => {
    const label = btn.textContent;
    btn.textContent = text;
    setTimeout(() => (btn.textContent = label), 1200);
  };
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.docs-shell [data-copy-target]')) {
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.copyTarget ?? '');
      const text = target instanceof HTMLTextAreaElement ? target.value : (target?.textContent ?? '');
      try {
        await navigator.clipboard.writeText(text);
        flash(btn, 'Copied');
      } catch {
        flash(btn, 'Copy failed');
      }
    });
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]')) {
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      try {
        const res = await fetch(btn.dataset.copyMarkdown!);
        if (!res.ok) throw new Error(String(res.status));
        const md = await res.text();
        await navigator.clipboard.writeText(btn.dataset.agentLine ? `${btn.dataset.agentLine}\n\n${md}` : md);
        flash(btn, 'Copied');
      } catch {
        flash(btn, 'Copy failed');
      }
    });
  }

  // ---------- Tabs ----------
  // Without JavaScript every panel shows under its label. Here each set
  // becomes a tab list; choosing a tab chooses it in every set on the page
  // that has the same key (Python everywhere), and is remembered.
  const TAB_KEY = 'docs-tab';
  const remembered = (() => {
    try {
      return JSON.parse(localStorage.getItem(TAB_KEY) ?? '[]') as string[];
    } catch {
      return [];
    }
  })();
  const detectOs = () => {
    const ua = navigator.userAgent.toLowerCase();
    if (/windows/.test(ua)) return 'windows';
    if (/mac os|macintosh/.test(ua)) return 'macos';
    return 'linux';
  };
  const sets = [...document.querySelectorAll<HTMLElement>('[data-tabs]')];
  const select = (key: string, remember: boolean) => {
    for (const set of sets) {
      const panels = [...set.querySelectorAll<HTMLElement>(':scope > .tab-panel')];
      if (!panels.some((p) => p.dataset.tabKey === key)) continue;
      for (const p of panels) p.hidden = p.dataset.tabKey !== key;
      for (const b of set.querySelectorAll<HTMLButtonElement>(':scope > .tab-list > button')) {
        const on = b.dataset.tabKey === key;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      }
    }
    if (remember) {
      const next = [key, ...remembered.filter((k) => k !== key)].slice(0, 8);
      remembered.splice(0, remembered.length, ...next);
      try {
        localStorage.setItem(TAB_KEY, JSON.stringify(next));
      } catch {
        // Storage blocked: the choice lasts for this page.
      }
    }
  };
  sets.forEach((set, n) => {
    const panels = [...set.querySelectorAll<HTMLElement>(':scope > .tab-panel')];
    if (!panels.length) return;
    const list = document.createElement('div');
    list.className = 'tab-list';
    list.setAttribute('role', 'tablist');
    panels.forEach((panel, i) => {
      const id = `tabs-${n}-${i}`;
      const b = document.createElement('button');
      b.type = 'button';
      b.id = `${id}-tab`;
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-controls', id);
      b.dataset.tabKey = panel.dataset.tabKey;
      b.textContent = panel.dataset.tabLabel ?? panel.dataset.tabKey ?? '';
      b.addEventListener('click', () => select(panel.dataset.tabKey!, true));
      b.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const buttons = [...list.querySelectorAll<HTMLButtonElement>('button')];
        const next = buttons[(buttons.indexOf(b) + step + buttons.length) % buttons.length];
        next.focus();
        next.click();
      });
      list.append(b);
      panel.id = id;
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', b.id);
    });
    set.prepend(list);
    set.classList.add('is-enhanced');
    const keys = panels.map((p) => p.dataset.tabKey!);
    const wanted =
      remembered.find((k) => keys.includes(k)) ??
      (set.dataset.tabsDetect === 'os' ? keys.find((k) => k.split('-').includes(detectOs())) : undefined) ??
      keys[0];
    select(wanted, false);
  });

  // ---------- On this page: open beside the content, collapsed above it ----------
  const toc = document.querySelector<HTMLDetailsElement>('.docs-toc details');
  if (toc) {
    const wide = window.matchMedia('(min-width: 1180px)');
    const sync = () => (toc.open = wide.matches);
    sync();
    wide.addEventListener('change', sync);
  }
</script>
