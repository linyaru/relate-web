{
  "name": "relate-web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8765",
    "dev:playground": "npm --prefix playground run dev --",
    "build": "astro build && npm run build:playground",
    "build:playground": "npm --prefix playground run build -- --outDir ../dist/playground --emptyOutDir",
    "preview": "astro preview --host 127.0.0.1 --port 8765",
    "check": "astro check",
    "check:playground": "npm --prefix playground run typecheck",
    "cookbook:check": "node scripts/cookbook.ts",
    "cookbook:record": "node scripts/cookbook.ts --record",
    "cookbook:test": "node --test \"src/lib/cookbook/*.test.ts\"",
    "cookbook:browser": "node scripts/cookbook-browser.ts",
    "cookbook:diagrams": "node scripts/cookbook-diagrams/render.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@neo4j-nvl/base": "1.2.2",
    "@neo4j-nvl/interaction-handlers": "1.2.2",
    "astro": "^7.4.7",
    "markdown-it": "^14.3.3",
    "parse5": "^8.1.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/d3-force": "3.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "d3-force": "3.0.0",
    "typescript": "^6.0.3"
  }
}
