---
// Shared page shell for section pages (/docs, /blog, ...): head, global styles, top bar, footer.
// The home page still renders the legacy markup (src/pages/index.astro) but uses the same
// Header and Footer components and base.css.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';
interface Props {
  title: string;
  description?: string;
  playgroundHref?: string;
  /** `docs` swaps the top bar for the slotted docs header and lets the page fill the width (docs pages, recipe pages). */
  chrome?: 'site' | 'docs';
}
const { title, description = '', playgroundHref, chrome = 'site' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — relate</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <link rel="preload" href="/fonts/relate-sans.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <slot name="head" />
  </head>
  <body>
    {chrome === 'docs' ? <slot name="header" /> : <Header playgroundHref={playgroundHref} />}
    <main class={chrome === 'docs' ? 'page' : 'page container'} id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
